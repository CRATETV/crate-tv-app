rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // FIX (support ticket — "Missing or insufficient permissions" on
    // every new signup): the old version called
    // request.resource.data.diff(resource.data) unconditionally.
    // `resource` doesn't exist yet on a create (every brand-new
    // account's very first write), which fails rule evaluation and
    // surfaces to the client as a permission error — blocking every
    // single new signup, not just updates.
    //
    // This checks each protected field's VALUE instead of just whether
    // its key is present in the write. That matters because
    // createUserProfile() legitimately writes these fields at their
    // safe defaults (false / [] / {}) on every new account — a
    // key-name-only check would keep blocking signup even once the
    // null-resource crash above is fixed. A field is only treated as
    // "being written" if its value would actually change from what it
    // already is (or from its safe default, if the document doesn't
    // exist yet) — so devtools tampering to self-grant paid access is
    // still blocked, same as before, while normal signup/update isn't.
    function protectedFieldUnchanged(field, defaultVal) {
      let touchesField = field in request.resource.data;
      let existingValue = resource != null ? resource.data.get(field, defaultVal) : defaultVal;
      return !touchesField || request.resource.data[field] == existingValue;
    }

    function isWritingProtectedFields() {
      // These fields grant access to paid content (movie rentals, watch
      // party tickets, festival block unlocks, and legacy block-unlock
      // formats) and were previously writable by clients directly —
      // meaning anyone with browser devtools could grant themselves any
      // paid movie or watch party for free by writing straight to their
      // own user doc. Access to these is now only ever granted
      // server-side (Admin SDK, which bypasses these rules) after a
      // verified payment or a verified ticket-code redemption — see
      // api/process-square-payment.ts and api/redeem-ticket-code.ts.
      return !protectedFieldUnchanged('hasFestivalAllAccess', false)
          || !protectedFieldUnchanged('hasCrateFestPass', false)
          || !protectedFieldUnchanged('hasJuryPass', false)
          || !protectedFieldUnchanged('isPremiumSubscriber', false)
          || !protectedFieldUnchanged('purchasedMovieKeys', [])
          || !protectedFieldUnchanged('rentals', {})
          || !protectedFieldUnchanged('unlockedWatchPartyKeys', [])
          || !protectedFieldUnchanged('unlockedBlocks', [])
          || !protectedFieldUnchanged('unlockedBlockIds', [])
          || !protectedFieldUnchanged('unlockedFestivalDays', []);
    }

    // ── Users ──────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid) && !isWritingProtectedFields();
      allow create: if isOwner(uid) && !isWritingProtectedFields();
      allow delete: if false;
    }

    // ── Watch parties — all subcollections allowed for signed-in users ─
    match /watch_parties/{partyId} {
      allow read: if true;
      allow write: if false; // server only

      match /messages/{messageId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }

      match /live_reactions/{reactionId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if false;
      }

      // Lobby viewers tracking — who is in the lobby waiting. Doc id is the
      // viewer's own email (see WatchPartyLobby.tsx), so ownership is
      // checked against that instead of just "any signed-in user" — that
      // used to let any signed-in visitor overwrite or delete someone
      // else's presence doc.
      match /lobby_viewers/{viewerId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && request.auth.token.email == viewerId;
        allow delete: if isSignedIn() && request.auth.token.email == viewerId;
      }
    }

    // ── Festival viewers log ───────────────────────────────────────────
    // Doc id is `${movieKey}_${email}`, and the doc itself also stores an
    // `email` field (see WatchPartyLobby.tsx) — checked against that field
    // rather than any signed-in user being able to write an arbitrary
    // viewer-log entry (or overwrite someone else's).
    match /festival_viewers/{viewerId} {
      allow read: if false; // admin only
      allow create, update: if isSignedIn() && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    // ── Festival tickets ───────────────────────────────────────────────
    match /festival_tickets/{ticketId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false; // server only
    }

    // ── Promo codes ────────────────────────────────────────────────────
    match /promo_codes/{codeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── PWFF invites ───────────────────────────────────────────────────
    match /pwff_invites/{email} {
      allow read: if isSignedIn() && request.auth.token.email == email;
      allow write: if false;
    }

    // ── Public content ─────────────────────────────────────────────────
    match /movies/{movieId} {
      allow read: if true;
      allow write: if false;
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if false;
    }

    match /content/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /data/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /festival/{docId} {
      allow read: if true;
      allow write: if false;
      match /{subcollection}/{subDocId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── View counts ────────────────────────────────────────────────────
    match /view_counts/{docId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // ── Watch party schedule (public) ──────────────────────────────────
    match /watch_party_schedule/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Film submissions ────────────────────────────────────────────────
    match /movie_pipeline/{submissionId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.submitterUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.submitterUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Watch sessions (viewership heartbeat, admin dashboard aggregation) ──
    match /watchSessions/{sessionId} {
      // Anyone signed in can read (admin dashboard needs to aggregate across all users)
      allow read: if isSignedIn();

      // A user can only create/update a session doc that has their own userId on it
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      // No deletes from the client — sessions are historical data
      allow delete: if false;
    }

    // ── Watch party comments ────────────────────────────────────────────
    match /comments/{blockId}/messages/{commentId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() < 500; // basic length cap, anti-spam

      // Users can delete their own comments; admin deletes go through the
      // existing server-side admin API pattern (Admin SDK), not a client rule.
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow update: if false; // comments aren't editable, keep it simple
    }

    // ── Deny everything else ───────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
