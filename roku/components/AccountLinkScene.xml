<?xml version="1.0" encoding="utf-8" ?>
<!--
    ============================================================================
    CRATE TV - Link this Roku to a Crate account
    ============================================================================
    Opens from the Account tab ("Link your account"), or after signing out.

    TWO WAYS TO LINK (whichever is easier for the viewer)
      1. Scan the QR code with a phone camera. It opens
         cratetv.net/link?code=ABC123 with the code already filled in;
         they sign in (if needed) and press "Link my Roku".
      2. Go to cratetv.net/link on any device and type the code.
    The Roku checks every few seconds (AccountLinkScene.brs) and moves on by
    itself as soon as the link is done. Codes last 15 minutes; a fresh one
    appears automatically if it runs out.

    LAYOUT: text and code on the left, QR card on the right, "Not now" button
    at the bottom left. Full screen (no top menu); `canvas` is shifted up 60px
    because this page sits inside MainScene's sceneContainer.

    Logic: AccountLinkScene.brs. Website side: components/LinkRokuPage.tsx and
    api/link-roku-account.ts.
    ============================================================================
-->
<component name="AccountLinkScene" extends="Group">
    <interface>
        <field id="linkComplete" type="boolean" value="false" alwaysNotify="true" />
        <field id="skipLink"     type="boolean" value="false" alwaysNotify="true" />
        <field id="linkCode"     type="string"  value="" />
        <field id="errorMessage" type="string"  value="" />
    </interface>

    <script type="text/brightscript" uri="pkg:/source/Config.brs" />
    <script type="text/brightscript" uri="pkg:/source/ResolutionManager.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <script type="text/brightscript" uri="AccountLinkScene.brs" />

    <children>
        <Group id="canvas" translation="[0, -60]">
            <Rectangle id="background" width="1920" height="1080" color="#000000" />


            <!-- ===== Left: what this is + the code ===== -->
            <Group translation="[96, 230]">
                <Label text="LINK YOUR ACCOUNT" color="#EF4444">
                    <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="22" />
                </Label>
                <Label text="Watch everything you've unlocked" color="#FFFFFF" width="900" wrap="true" maxLines="2" translation="[0, 40]">
                    <Font role="font" uri="pkg:/fonts/InterDisplay-Bold.ttf" size="60" />
                </Label>
                <Label text="Films and festival tickets you buy on cratetv.net play here once this Roku is linked to your Crate account."
                       color="#B3B3B3" width="860" wrap="true" maxLines="3" lineSpacing="5" translation="[0, 205]">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="27" />
                </Label>

                <Label text="Or go to  cratetv.net/link  on any device and enter:" color="#D2D2D2" width="900" translation="[0, 345]">
                    <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="27" />
                </Label>

                <!-- The code -->
                <Poster width="460" height="120" uri="pkg:/images/ui/card.9.png" translation="[0, 400]" />
                <Label id="linkCodeLabel" text="" color="#FFFFFF" width="460" height="120"
                       horizAlign="center" vertAlign="center" translation="[0, 400]">
                    <Font role="font" uri="pkg:/fonts/InterDisplay-Bold.ttf" size="72" />
                </Label>
                <BusySpinner id="codeSpinner" translation="[198, 428]" visible="false" />

                <!-- Status / error -->
                <Label id="statusLabel" text="" color="#8C8C8C" width="900" translation="[0, 545]">
                    <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="24" />
                </Label>
                <Label id="errorLabel" text="" color="#EF4444" width="900" wrap="true" maxLines="2" translation="[0, 545]" visible="false">
                    <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="24" />
                </Label>
            </Group>

            <!-- "Not now" button (always focused; OK skips, Back too) -->
            <Group translation="[96, 880]">
                <Poster id="skipButtonBg" width="200" height="64" uri="pkg:/images/ui/btn_focus.9.png" />
                <Label id="skipButtonLabel" text="Not now" color="#000000" width="200" height="64" horizAlign="center" vertAlign="center">
                    <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="26" />
                </Label>
            </Group>
            <Label text="You can link later from the Account tab." color="#8C8C8C" translation="[320, 898]">
                <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="22" />
            </Label>

            <!-- ===== Right: QR card ===== -->
            <Group translation="[1184, 230]">
                <Poster width="640" height="640" uri="pkg:/images/ui/card.9.png" />
                <Label text="Scan with your phone" color="#FFFFFF" width="640" horizAlign="center" translation="[0, 48]">
                    <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="32" />
                </Label>
                <Rectangle width="392" height="392" color="#FFFFFF" translation="[124, 118]" />
                <Poster id="qrCode" width="360" height="360" translation="[140, 134]" loadingBitmapOpacity="0.0" />
                <Label text="Your camera opens the link page with the code already filled in."
                       color="#B3B3B3" width="540" wrap="true" maxLines="2" horizAlign="center" translation="[50, 538]">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="22" />
                </Label>
            </Group>
        </Group>
    </children>
</component>
