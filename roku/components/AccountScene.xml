<?xml version="1.0" encoding="utf-8" ?>
<!--
    ============================================================================
    CRATE TV - Account tab
    ============================================================================
    Shows who this Roku is linked to, the device, and one button:
      linked      -> "Sign Out" (asks to confirm first)
      not linked  -> "Link your account" (opens the link screen)
    AccountScene.brs fills in the text and handles the button.

    LAYOUT (screen positions; `canvas` is shifted up 60px because this page
    sits inside MainScene's sceneContainer, under the top menu)
      Left:  title, profile (photo/initial, name, email, status), details card,
             the button, help line.
      Right: "Manage your account" card with a QR code to cratetv.net/account.
      Confirm dialog: dark overlay + card, shown only when signing out.
    ============================================================================
-->
<component name="AccountScene" extends="Group">
    <interface>
        <field id="signOutRequested" type="boolean" value="false" alwaysNotify="true" />
        <field id="exitRequested"    type="boolean" value="false" alwaysNotify="true" />
        <!-- The catalogue (MainScene sets it): carries the viewer's watch streak -->
        <field id="feedData"         type="node" onChange="OnFeedData" />
    </interface>

    <script type="text/brightscript" uri="pkg:/source/Config.brs" />
    <script type="text/brightscript" uri="pkg:/source/ResolutionManager.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <script type="text/brightscript" uri="AccountScene.brs" />

    <children>
        <Group id="canvas" translation="[0, -60]">
            <Rectangle width="1920" height="1080" color="#000000" />

            <Label text="Account" color="#FFFFFF" translation="[96, 120]">
                <Font role="font" uri="pkg:/fonts/InterDisplay-Bold.ttf" size="56" />
            </Label>

            <!-- ===== Profile ===== -->
            <Group translation="[96, 230]">
                <Rectangle id="avatarFallback" width="132" height="132" color="#262626" />
                <Label id="avatarFallbackText" text="C" color="#FFFFFF" width="132" height="132" horizAlign="center" vertAlign="center">
                    <Font role="font" uri="pkg:/fonts/InterDisplay-Bold.ttf" size="60" />
                </Label>
                <Poster id="avatarPoster" width="132" height="132" uri="" loadDisplayMode="scaleToZoom" />

                <Label id="userNameLabel" text="" color="#FFFFFF" width="760" maxLines="1" translation="[168, 10]">
                    <Font role="font" uri="pkg:/fonts/InterDisplay-Bold.ttf" size="44" />
                </Label>
                <Label id="userEmailLabel" text="" color="#B3B3B3" width="760" maxLines="1" translation="[168, 70]">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="26" />
                </Label>
                <Label id="statusValueLabel" text="" color="#4ADE80" translation="[168, 108]">
                    <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="22" />
                </Label>
            </Group>

            <!-- ===== Details card ===== -->
            <Group translation="[96, 410]">
                <Poster id="detailsCard" width="980" height="290" uri="pkg:/images/ui/card.9.png" />

                <Label text="PLAN" color="#8C8C8C" translation="[40, 34]">
                    <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="20" />
                </Label>
                <Label id="subscriptionLabel" text="" color="#FFFFFF" width="420" maxLines="1" translation="[40, 64]">
                    <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="28" />
                </Label>
                <Label id="subscriptionDetail" text="" color="#B3B3B3" width="420" maxLines="1" translation="[40, 104]">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="22" />
                </Label>

                <Label text="DEVICE" color="#8C8C8C" translation="[520, 34]">
                    <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="20" />
                </Label>
                <Label id="deviceModelLabel" text="" color="#FFFFFF" width="420" maxLines="1" translation="[520, 64]">
                    <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="28" />
                </Label>
                <Label id="deviceIdLabel" text="" color="#B3B3B3" width="420" maxLines="1" translation="[520, 104]">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="22" />
                </Label>

                <Rectangle width="900" height="1" color="#2A2A2A" translation="[40, 160]" />

                <Label text="CHANNEL VERSION" color="#8C8C8C" translation="[40, 188]">
                    <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="20" />
                </Label>
                <Label id="appVersionLabel" text="" color="#FFFFFF" translation="[40, 218]">
                    <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="26" />
                </Label>
                <Label text="NEED HELP?" color="#8C8C8C" translation="[520, 188]">
                    <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="20" />
                </Label>
                <Label text="support@cratetv.net" color="#FFFFFF" translation="[520, 218]">
                    <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="26" />
                </Label>

                <!-- Watch streak + badges (only when linked and there's a streak) -->
                <Group id="streakRow" translation="[0, 270]" visible="false">
                    <Rectangle width="900" height="1" color="#2A2A2A" translation="[40, 0]" />
                    <Label text="WATCH STREAK" color="#8C8C8C" translation="[40, 26]">
                        <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="20" />
                    </Label>
                    <Poster uri="pkg:/images/ui/icon_fire.png" width="34" height="34" translation="[40, 56]" />
                    <Label id="streakLabel" text="" color="#FFFFFF" width="400" maxLines="1" translation="[84, 58]">
                        <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="26" />
                    </Label>
                    <Label text="BADGES" color="#8C8C8C" translation="[520, 26]">
                        <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="20" />
                    </Label>
                    <Label id="badgesLabel" text="" color="#FFFFFF" width="420" wrap="true" maxLines="2" translation="[520, 58]">
                        <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="22" />
                    </Label>
                </Group>
            </Group>

            <!-- ===== The button (Sign Out / Link your account) ===== -->
            <Group id="buttonGroup" translation="[96, 760]">
                <Poster id="signOutBg" width="340" height="68" uri="pkg:/images/ui/btn_focus.9.png" />
                <Label id="signOutLabel" text="Sign Out" color="#000000" width="340" height="68" horizAlign="center" vertAlign="center">
                    <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="26" />
                </Label>
            </Group>

            <!-- ===== Manage on your phone ===== -->
            <Group translation="[1184, 230]">
                <Poster width="640" height="560" uri="pkg:/images/ui/card.9.png" />
                <Label text="Manage your account" color="#FFFFFF" width="640" horizAlign="center" translation="[0, 44]">
                    <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="30" />
                </Label>
                <Label text="Purchases, tickets, profile and watch history" color="#B3B3B3" width="640" horizAlign="center" translation="[0, 92]">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="22" />
                </Label>
                <Rectangle width="292" height="292" color="#FFFFFF" translation="[174, 146]" />
                <Poster id="qrCodePoster" width="260" height="260" translation="[190, 162]" loadingBitmapOpacity="0.0"
                        uri="https://api.qrserver.com/v1/create-qr-code/?size=260x260&amp;margin=0&amp;data=https%3A%2F%2Fcratetv.net%2Faccount" />
                <Label text="Scan with your phone, or visit" color="#8C8C8C" width="640" horizAlign="center" translation="[0, 466]">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="22" />
                </Label>
                <Label text="cratetv.net/account" color="#FFFFFF" width="640" horizAlign="center" translation="[0, 500]">
                    <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="24" />
                </Label>
            </Group>

            <!-- ===== Confirm sign out ===== -->
            <Group id="confirmDialog" visible="false">
                <Rectangle width="1920" height="1080" color="#000000" opacity="0.85" />
                <Group translation="[560, 380]">
                    <Poster width="800" height="320" uri="pkg:/images/ui/card.9.png" />
                    <Label text="Sign out of Crate TV?" color="#FFFFFF" translation="[48, 44]">
                        <Font role="font" uri="pkg:/fonts/InterDisplay-Bold.ttf" size="40" />
                    </Label>
                    <Label text="Films you've bought stay in your account. You'll need to link this Roku again to watch them here."
                           color="#B3B3B3" width="704" wrap="true" maxLines="2" translation="[48, 108]">
                        <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="24" />
                    </Label>
                    <Poster id="confirmYesBg" width="240" height="64" uri="pkg:/images/ui/btn_idle.9.png" translation="[48, 212]" />
                    <Label id="confirmYesLabel" text="Sign Out" color="#FFFFFF" width="240" height="64" horizAlign="center" vertAlign="center" translation="[48, 212]">
                        <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="24" />
                    </Label>
                    <Poster id="confirmNoBg" width="240" height="64" uri="pkg:/images/ui/btn_focus.9.png" translation="[308, 212]" />
                    <Label id="confirmNoLabel" text="Cancel" color="#000000" width="240" height="64" horizAlign="center" vertAlign="center" translation="[308, 212]">
                        <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="24" />
                    </Label>
                </Group>
            </Group>
        </Group>
    </children>
</component>
