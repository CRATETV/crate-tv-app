<?xml version="1.0" encoding="utf-8" ?>
<!--
    ============================================================================
    CRATE TV - Watch Party screen (full screen; the top menu is hidden)
    ============================================================================
    WatchPartyScene.brs shows ONE of these states, from the party's status:
      loadingState   checking the party's status
      waitingState   party scheduled: big countdown, starts by itself
      paidState      ticketed party this Roku hasn't unlocked: QR to buy
      endedState     party over: OK watches from the beginning
      noLiveState    no party live right now: QR to the schedule
      blockState     festival blocks with several films play on the web
      qaOverlay      thin bar shown during a live director Q&A
    Design: the film's artwork, dimmed, behind centred text, the same fonts
    and colours as the rest of the channel.

    Screen positions: `canvas` is shifted up 60px because this page sits
    inside MainScene's sceneContainer.
    ============================================================================
-->
<component name="WatchPartyScene" extends="Group">
    <interface>
        <field id="film"          type="node"    onChange="OnFilmSet" />
        <field id="authToken"     type="string"  value="" />
        <field id="playContent"   type="node"    alwaysNotify="true" />
        <field id="exitRequested" type="boolean" value="false" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="pkg:/source/Config.brs" />
    <script type="text/brightscript" uri="pkg:/source/ResolutionManager.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <script type="text/brightscript" uri="WatchPartyScene.brs" />

    <children>
        <Group id="canvas" translation="[0, -60]">
            <Rectangle id="bg" width="1920" height="1080" color="#000000" />
            <!-- The film's artwork, dimmed, with the edges melting into black -->
            <Poster id="backdropPoster" width="1920" height="1080" loadDisplayMode="scaleToZoom"
                    loadingBitmapOpacity="0.0" failedBitmapOpacity="0.0" opacity="0.28" />
            <Poster uri="pkg:/images/ui/fade_top.png"    width="1920" height="260" />
            <Poster uri="pkg:/images/ui/fade_bottom.png" width="1920" height="520" translation="[0, 560]" />


            <!-- Always shown -->
            <Label id="eyebrow" text="●  WATCH PARTY" color="#EF4444" width="1920" horizAlign="center" translation="[0, 190]">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="24" />
            </Label>
            <Label id="filmTitle" text="" color="#FFFFFF" width="1600" horizAlign="center" maxLines="1" translation="[160, 232]">
                <Font role="font" uri="pkg:/fonts/InterDisplay-Bold.ttf" size="64" />
            </Label>

            <Group id="loadingState" visible="true">
                <Label id="loadingLabel" text="Checking the watch party..." color="#8C8C8C" width="1920" horizAlign="center" translation="[0, 520]">
                    <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="26" />
                </Label>
            </Group>

            <Group id="waitingState" visible="false">
                <Label text="STARTS IN" color="#8C8C8C" width="1920" horizAlign="center" translation="[0, 400]">
                    <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="24" />
                </Label>
                <Label id="countdownLabel" text="--:--:--" color="#FFFFFF" width="1920" horizAlign="center" translation="[0, 440]">
                    <Font role="font" uri="pkg:/fonts/InterDisplay-Bold.ttf" size="120" />
                </Label>
                <Label text="Stay here: the film starts by itself, in sync with everyone." color="#B3B3B3" width="1920" horizAlign="center" translation="[0, 620]">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="26" />
                </Label>
                <Label id="waitingParticipants" text="" color="#8C8C8C" width="1920" horizAlign="center" translation="[0, 680]">
                    <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="22" />
                </Label>
            </Group>

            <Group id="paidState" visible="false">
                <Label text="This watch party needs a ticket" color="#FFFFFF" width="1920" horizAlign="center" translation="[0, 350]">
                    <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="32" />
                </Label>
                <Label text="Buy it on your phone, then come back. This screen opens the party once you have it." color="#B3B3B3" width="1920" horizAlign="center" translation="[0, 400]">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="24" />
                </Label>
                <Rectangle width="252" height="252" color="#FFFFFF" translation="[834, 460]" />
                <Poster id="paidQrPoster" width="236" height="236" translation="[842, 468]" loadDisplayMode="scaleToFit" loadingBitmapOpacity="0.0" />
                <Label id="paidUrlLabel" text="cratetv.net/watchparty" color="#FFFFFF" width="1920" horizAlign="center" translation="[0, 736]">
                    <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="24" />
                </Label>
            </Group>

            <Group id="endedState" visible="false">
                <Label text="This watch party has ended" color="#FFFFFF" width="1920" horizAlign="center" translation="[0, 400]">
                    <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="32" />
                </Label>
                <Label text="You can still watch the film from the beginning." color="#B3B3B3" width="1920" horizAlign="center" translation="[0, 452]">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="26" />
                </Label>
                <Poster id="watchBtn" width="380" height="68" uri="pkg:/images/ui/btn_focus.9.png" translation="[770, 530]" />
                <Label text="▶  Watch from the beginning" color="#000000" width="380" height="68" horizAlign="center" vertAlign="center" translation="[770, 530]">
                    <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="24" />
                </Label>
            </Group>

            <Group id="noLiveState" visible="false">
                <Label text="No watch party is live right now" color="#FFFFFF" width="1920" horizAlign="center" translation="[0, 350]">
                    <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="32" />
                </Label>
                <Label text="Upcoming watch parties are listed on cratetv.net." color="#B3B3B3" width="1920" horizAlign="center" translation="[0, 400]">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="24" />
                </Label>
                <Rectangle width="252" height="252" color="#FFFFFF" translation="[834, 460]" />
                <Poster width="236" height="236" translation="[842, 468]" loadDisplayMode="scaleToFit" loadingBitmapOpacity="0.0" uri="https://api.qrserver.com/v1/create-qr-code/?size=236x236&amp;margin=0&amp;data=https%3A%2F%2Fcratetv.net%2Fwatchparty" />
                <Label text="cratetv.net/watchparty" color="#FFFFFF" width="1920" horizAlign="center" translation="[0, 736]">
                    <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="24" />
                </Label>
            </Group>

            <Group id="blockState" visible="false">
                <Label text="This festival block plays on cratetv.net" color="#FFFFFF" width="1920" horizAlign="center" translation="[0, 350]">
                    <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="32" />
                </Label>
                <Label text="Scan to join on your phone, tablet or computer." color="#B3B3B3" width="1920" horizAlign="center" translation="[0, 400]">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="24" />
                </Label>
                <Rectangle width="252" height="252" color="#FFFFFF" translation="[834, 460]" />
                <Poster width="236" height="236" translation="[842, 468]" loadDisplayMode="scaleToFit" loadingBitmapOpacity="0.0" uri="https://api.qrserver.com/v1/create-qr-code/?size=236x236&amp;margin=0&amp;data=https%3A%2F%2Fcratetv.net%2Fwatchparty" />
                <Label text="cratetv.net/watchparty" color="#FFFFFF" width="1920" horizAlign="center" translation="[0, 736]">
                    <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="24" />
                </Label>
            </Group>

            <!-- Vote from the couch: festival blocks with 2+ films, while Audience
                 Choice voting is open (or results once it closes). Rows are
                 built in WatchPartyScene.brs; refreshed every 15 seconds. -->
            <Group id="voteState" visible="false">
                <Label id="voteHeading" text="Vote for Audience Choice" color="#FFFFFF" width="1920" horizAlign="center" translation="[0, 330]">
                    <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="34" />
                </Label>
                <Label id="voteSub" text="Ticket holders: scan with your phone and pick your favourite film." color="#B3B3B3" width="1920" horizAlign="center" translation="[0, 384]">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="24" />
                </Label>
                <Group id="voteQrGroup" translation="[300, 460]">
                    <Rectangle width="316" height="316" color="#FFFFFF" />
                    <Poster id="voteQr" width="300" height="300" translation="[8, 8]" loadingBitmapOpacity="0.0" />
                    <Label id="voteUrl" text="" color="#FFFFFF" width="316" horizAlign="center" translation="[0, 336]">
                        <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="20" />
                    </Label>
                </Group>
                <Group id="voteRows" translation="[720, 470]" />
                <Label id="voteTotal" text="" color="#8C8C8C" translation="[720, 800]">
                    <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="22" />
                </Label>
            </Group>

            <!-- Shown during a live director Q&A -->
            <Group id="qaOverlay" visible="false">
                <Poster uri="pkg:/images/ui/fade_player_top.png" width="1920" height="160" />
                <Poster width="420" height="48" uri="pkg:/images/ui/pill_red.9.png" translation="[96, 60]" />
                <Label text="●  LIVE  ·  Director Q&amp;A" color="#FFFFFF" width="420" height="48" horizAlign="center" vertAlign="center" translation="[96, 60]">
                    <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="22" />
                </Label>
            </Group>
        </Group>
    </children>
</component>
