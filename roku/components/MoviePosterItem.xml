<?xml version="1.0" encoding="utf-8" ?>
<!--
    ============================================================================
    CRATE TV - Poster tile (one film in a row on the Home screen)
    ============================================================================

    WHERE IT'S USED
      HomeScene's RowList draws one of these per film (itemComponentName =
      "MoviePosterItem"). The RowList sets `width` / `height` from
      HomeScene's rowItemSize and fills `itemContent` with the film.

    WHAT IT SHOWS
      - The poster, with rounded corners (tile_corner_mask.png covers the
        corners with the page's black background colour).
      - A white focus ring and a gentle zoom when the viewer lands on it.
      - A small dark pill in the top-right for locked films:
        lock icon + price (e.g. "$4.99"), or just the lock if there's no price.
      - A thin red progress bar along the bottom if the viewer started it.
      - TOP 10 rows only: a big rank number to the left of the poster,
        like the Netflix Top 10 row. HomeScene gives those rows wider tiles
        (see TOP_TEN_TILE_WIDTH in HomeScene.brs) and sets `rankNumber`.

    TO CHANGE THE LOOK
      - Poster size: roku/source/Theme.brs (tileWidth / tileHeight) and
        HomeScene.brs (rowItemSize). Keep both the same.
      - Focus zoom amount: FOCUS_SCALE in MoviePosterItem.brs.
      - Ring and mask images: roku/images/ui/focus_ring_tile.png and
        tile_corner_mask.png (made for a 214 x 321 poster).
    ============================================================================
-->
<component name="MoviePosterItem" extends="Group">
    <interface>
        <!-- Set by the RowList -->
        <field id="itemContent"     type="node"    onChange="OnContentChange" />
        <field id="focusPercent"    type="float"   value="0.0" onChange="OnFocusChange" />
        <field id="rowFocusPercent" type="float"   value="0.0" />
        <field id="itemHasFocus"    type="boolean" value="false" />
        <field id="width"           type="float"   value="214" onChange="Layout" />
        <field id="height"          type="float"   value="321" onChange="Layout" />
    </interface>

    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
    <script type="text/brightscript" uri="MoviePosterItem.brs" />

    <children>
        <!-- TOP 10 rank number (only visible on the Top 10 row) -->
        <Label id="rankLabel" text="" visible="false" color="#3A3A3A" horizAlign="right" vertAlign="bottom">
            <Font role="font" uri="pkg:/fonts/InterDisplay-Black.ttf" size="250" />
        </Label>

        <!-- Everything that zooms on focus sits in posterGroup -->
        <Group id="posterGroup">
            <!-- Placeholder colour + film title, visible until the poster loads (or if it fails) -->
            <Rectangle id="posterBg" width="214" height="321" color="#1C1C1C" />
            <Label id="fallbackTitle" text="" color="#8C8C8C" width="186" height="293" translation="[14, 14]"
                   wrap="true" maxLines="5" horizAlign="center" vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="24" />
            </Label>

            <!-- The poster image. Fades in once loaded (see OnPosterLoadStatus). -->
            <Poster id="posterImage" width="214" height="321" loadWidth="214" loadHeight="321"
                    loadDisplayMode="scaleToZoom" loadingBitmapOpacity="0.0" failedBitmapOpacity="0.0" opacity="0.0" />

            <!-- Rounded corners -->
            <Poster id="cornerMask" width="214" height="321" uri="pkg:/images/ui/tile_corner_mask.png" />

            <!-- Locked film: lock + price pill, top-right -->
            <Group id="lockPill" visible="false">
                <Poster id="lockPillBg" width="104" height="38" uri="pkg:/images/ui/pill_dark.9.png" />
                <Poster id="lockIcon" width="20" height="20" uri="pkg:/images/ui/icon_lock.png" translation="[12, 9]" />
                <Label id="lockPrice" text="" color="#FFFFFF" height="38" vertAlign="center" translation="[38, 0]">
                    <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="20" />
                </Label>
            </Group>

            <!-- Continue-watching progress -->
            <Group id="progressGroup" visible="false">
                <Rectangle id="progressTrack" width="214" height="5" color="#FFFFFF" opacity="0.25" />
                <Rectangle id="progressFill"  width="0"   height="5" color="#EF4444" />
            </Group>

            <!-- White focus ring, 7px outside the poster -->
            <Poster id="focusRing" width="228" height="335" uri="pkg:/images/ui/focus_ring_tile.png"
                    translation="[-7, -7]" visible="false" />
        </Group>
    </children>
</component>
