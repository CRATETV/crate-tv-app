<?xml version="1.0" encoding="utf-8" ?>
<!--
    ============================================================================
    CRATE TV - Public Square (the free films tab)
    ============================================================================
    Shows only the free rows from the catalogue: "The Square", "Public Domain
    Classics", vintage/retro and community rows. SquareScene.brs decides which
    rows count (IsSquareRow).

    LAYOUT (screen positions; this page sits inside MainScene's sceneContainer,
    which starts at y=60, so `canvas` is shifted up 60px)
      - Solid black page; the top menu (Header) is drawn above it.
      - Title + one-line description at the top left.
      - Rows of posters below, the same tiles as Home (MoviePosterItem).

    WHAT HAPPENS
      OK on a poster -> the film's page (TitleScene), same as Home.
      Up on the first row, or Back -> back to the top menu.

    HISTORY
      Until Oct 2026 this tab used "StandardPoster" tiles, which borrowed the
      Home tile's code. When Home's tile was redesigned, the borrowed code no
      longer matched and the channel crashed on this tab. It now uses
      MoviePosterItem directly, so the two can't drift apart again.
    ============================================================================
-->
<component name="SquareScene" extends="Group">
    <interface>
        <field id="feedData"      type="node"    onChange="OnFeedSet" />
        <field id="playContent"   type="node"    alwaysNotify="true" />
        <field id="exitRequested" type="boolean" value="false" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="pkg:/source/Config.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
    <script type="text/brightscript" uri="SquareScene.brs" />

    <children>
        <Group id="canvas" translation="[0, -60]">
            <Rectangle width="1920" height="1080" color="#000000" />

            <Label id="squareTitle" text="Public Square" color="#FFFFFF" translation="[96, 112]">
                <Font role="font" uri="pkg:/fonts/InterDisplay-Bold.ttf" size="56" />
            </Label>
            <Label id="squareSubtitle" text="Free to watch: classics, community films and independent work."
                   color="#B3B3B3" translation="[96, 186]">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="26" />
            </Label>

            <!-- Rows of posters. Sizes are set in SquareScene.brs (TILE_W / TILE_H). -->
            <RowList
                id="squareRowList"
                translation="[0, 250]"
                itemSize="[1920, 400]"
                itemSpacing="[0, 30]"
                numRows="2"
                showRowLabel="[true]"
                showRowCounter="[false]"
                rowLabelOffset="[[96, 12]]"
                rowLabelColor="#E5E5E5"
                focusXOffset="[96]"
                drawFocusFeedback="false"
                vertFocusAnimationStyle="fixedFocus"
                rowFocusAnimationStyle="fixedFocusWrap"
                visible="false">
                <Font role="rowLabelFont" uri="pkg:/fonts/Inter-SemiBold.ttf" size="30" />
            </RowList>

            <Label id="emptyLabel" text="Nothing in the Public Square right now. Check back soon."
                   color="#8C8C8C" width="1920" horizAlign="center" translation="[0, 560]" visible="false">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="28" />
            </Label>
        </Group>
    </children>
</component>
