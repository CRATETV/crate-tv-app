<?xml version="1.0" encoding="utf-8" ?>
<!--
    ============================================================================
    CRATE TV - Header menu (top of every main tab)
    ============================================================================

      [CRATE]   Home   Now Streaming   Public Square   Search   Account     ● LIVE WATCH PARTY   7:42 PM

    - On Home it floats over the billboard on a soft black-to-transparent
      fade (fade_top.png), like Netflix. On every other tab it sits on a solid
      black 72px bar (MainScene sets overArtwork), so nothing is dimmed.
    - The tab you're on is white with a short red bar under it.
    - When the menu has focus (press Up from the first row), the item you're
      on is white and bold-ish; the others are grey.
    - The red "LIVE WATCH PARTY" pill appears only while a party is live
      (MainScene sets watchPartyIsLive). Press Right past "Account" to reach it.

    MENU ORDER IS IMPORTANT: MainScene.OnNavSelectionChange() opens a tab by
    its number: 0 Home, 1 Now Streaming, 2 Public Square, 3 Search,
    4 Account, -1 the live party pill. If you add/reorder items, update both.
    ============================================================================
-->
<component name="Header" extends="Group">
    <interface>
        <field id="selectedIndex"    type="integer" value="0"     alwaysNotify="true" />  <!-- tab opened (OK) -->
        <field id="focusedIndex"     type="integer" value="0" />                          <!-- item highlighted -->
        <field id="isActive"         type="boolean" value="false" onChange="OnActiveChange" />  <!-- menu has focus -->
        <field id="watchPartyIsLive" type="boolean" value="false" onChange="OnWatchPartyLiveChange" />
        <!-- true on Home: float over the artwork on a soft fade. false on other
             tabs: solid black bar, so their headings are never dimmed. -->
        <field id="overArtwork"      type="boolean" value="true"  onChange="OnBackgroundModeChange" />
    </interface>

    <script type="text/brightscript" uri="pkg:/source/Config.brs" />
    <script type="text/brightscript" uri="pkg:/source/ResolutionManager.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
    <script type="text/brightscript" uri="Header.brs" />

    <children>
        <Timer id="clockTimer" duration="20" repeat="true" />

        <!-- Everything starts hidden; MainScene reveals the header once the feed has loaded. -->
        <Poster id="navBg" uri="pkg:/images/ui/fade_top.png" width="1920" height="170" visible="false" />
        <Rectangle id="navSolidBg" width="1920" height="72" color="#000000" visible="false" />

        <!-- Logo: hidden by request (Oct 2026). To bring it back, set
             SHOW_LOGO = true in Header.brs. -->
        <Poster id="headerLogo" width="150" height="37" uri="pkg:/images/crate_logo_small.png" translation="[96, 18]" visible="false" />

        <!-- Menu items. Header.brs spaces them out to fit their text. -->
        <Group id="navItemsGroup" translation="[96, 0]" visible="false">
            <Group id="navItem0"><Label id="navLabel0" text="Home"          color="#FFFFFF" height="72" vertAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="26" /></Label><Rectangle id="navUnderline0" width="28" height="3" color="#EF4444" translation="[0, 58]" /></Group>
            <Group id="navItem1"><Label id="navLabel1" text="Now Streaming" color="#B3B3B3" height="72" vertAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="26" /></Label><Rectangle id="navUnderline1" width="28" height="3" color="#EF4444" translation="[0, 58]" visible="false" /></Group>
            <Group id="navItem2"><Label id="navLabel2" text="Public Square" color="#B3B3B3" height="72" vertAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="26" /></Label><Rectangle id="navUnderline2" width="28" height="3" color="#EF4444" translation="[0, 58]" visible="false" /></Group>
            <Group id="navItem3"><Label id="navLabel3" text="Search"        color="#B3B3B3" height="72" vertAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="26" /></Label><Rectangle id="navUnderline3" width="28" height="3" color="#EF4444" translation="[0, 58]" visible="false" /></Group>
            <Group id="navItem4"><Label id="navLabel4" text="Account"       color="#B3B3B3" height="72" vertAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="26" /></Label><Rectangle id="navUnderline4" width="28" height="3" color="#EF4444" translation="[0, 58]" visible="false" /></Group>
        </Group>

        <!-- LIVE WATCH PARTY pill (only while a party is live) -->
        <Group id="livePartyAlert" translation="[1340, 12]" visible="false">
            <Poster id="alertFocusRing" width="324" height="56" uri="pkg:/images/ui/btn_focus.9.png" translation="[-4, -4]" visible="false" />
            <Poster id="alertBg" width="316" height="48" uri="pkg:/images/ui/pill_red.9.png" />
            <Label id="alertLabel" text="●  LIVE WATCH PARTY" color="#FFFFFF" width="316" height="48" horizAlign="center" vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="22" />
            </Label>
        </Group>

        <Label id="clockLabel" color="#B3B3B3" width="140" height="72" horizAlign="right" vertAlign="center" translation="[1684, 0]" visible="false">
            <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="24" />
        </Label>
    </children>
</component>
