<?xml version="1.0" encoding="utf-8" ?>
<!--
    ============================================================================
    CRATE TV - Search tab
    ============================================================================
    Left:  search box + on-screen keyboard (keys built in SearchScene.brs).
           Viewers can also type with the Roku phone app (mobileTextBox).
    Right: results grid, 5 x 2 posters (films and actors). Before typing it
           shows "Top searches" (the Top 10).
    OK on a film opens its film page; on an actor, their page.
    Up from the top row -> back to the top menu.

    Screen positions: `canvas` is shifted up 60px because this page sits
    inside MainScene's sceneContainer, under the top menu.
    ============================================================================
-->
<component name="SearchScene" extends="Group">
    <interface>
        <field id="feedData" type="node" onChange="OnFeedDataReady" />
        <field id="playContent" type="node" alwaysNotify="true" />
        <field id="exitRequested" type="boolean" value="false" alwaysNotify="true" />
        <field id="showActorDetail" type="string" value="" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="pkg:/source/Config.brs" />
    <script type="text/brightscript" uri="pkg:/source/ResolutionManager.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
    <script type="text/brightscript" uri="SearchScene.brs" />

    <children>
        <!-- Mobile keyboard bridge: lets viewers type with the Roku phone app -->
        <TextEditBox id="mobileTextBox" translation="[0, 1100]" width="1" height="1" opacity="0.0" />

        <Group id="canvas" translation="[0, -60]">
            <Rectangle width="1920" height="1080" color="#000000" />

            <!-- ===== LEFT: search box + keyboard ===== -->
            <Group id="leftPanel" translation="[96, 130]">
                <Poster width="594" height="68" uri="pkg:/images/ui/card.9.png" />
                <Label id="searchInput" text="" color="#FFFFFF" translation="[24, 0]" width="546" height="68" vertAlign="center" maxLines="1">
                    <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="30" />
                </Label>
                <Label id="searchPlaceholder" text="Search films, directors, cast" color="#8C8C8C" translation="[24, 0]" width="546" height="68" vertAlign="center">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="26" />
                </Label>
                <Label id="mobileHint" text="" color="#8C8C8C" translation="[0, 76]" width="594" visible="false">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="22" />
                </Label>
                <Rectangle id="searchCursor" width="3" height="34" color="#EF4444" translation="[24, 17]" visible="true" />

                <!-- Keys are created in SearchScene.brs (BuildKeyboard) -->
                <Group id="keyboardGroup" translation="[0, 100]">
                    <LayoutGroup id="keyboardGrid" layoutDirection="vert" itemSpacings="[6]" />
                </Group>
                <Label text="Tip: type with your phone using the Roku mobile app." color="#8C8C8C" width="594" wrap="true" translation="[0, 370]">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="20" />
                </Label>
            </Group>

            <!-- ===== RIGHT: results ===== -->
            <Group id="resultsGroup" translation="[756, 130]">
                <Label id="resultsLabel" text="Top searches" color="#E5E5E5" translation="[0, 0]">
                    <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="30" />
                </Label>

                <!-- 5 x 2 posters. White focus outline like Home. -->
                <PosterGrid
                    id="resultsGrid"
                    translation="[0, 56]"
                    basePosterSize="[200, 300]"
                    numColumns="5"
                    numRows="2"
                    itemSpacing="[16, 30]"
                    drawFocusFeedback="true"
                    drawFocusFeedbackOnTop="true"
                    focusBitmapUri="pkg:/images/ui/focus_ring_grid.9.png"
                    vertFocusAnimationStyle="floatingFocus"
                    visible="true" />

                <Label id="noResultsLabel" text="" color="#8C8C8C" width="1064" horizAlign="center" translation="[0, 300]" visible="false">
                    <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="28" />
                </Label>

                <!-- Shown under the grid while an actor is highlighted -->
                <Label id="actorHint" text="" color="#B3B3B3" width="1064" maxLines="1" translation="[0, 720]">
                    <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="24" />
                </Label>

                <!-- Old pop-out actor card: no longer shown (it covered the
                     results). Kept so SearchScene.brs can still find it. -->
                <Group id="actorPanel" translation="[0, 56]" visible="false">
                    <Poster width="1064" height="420" uri="pkg:/images/ui/card.9.png" />
                    <Poster id="actorPanelPhoto" translation="[28, 28]" width="240" height="360" loadDisplayMode="scaleToZoom" />
                    <Label id="bioScrollUp"   text="" color="#8C8C8C" translation="[1020, 12]" visible="false">
                        <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="24" />
                    </Label>
                    <Label id="bioScrollDown" text="" color="#8C8C8C" translation="[1020, 380]" visible="false">
                        <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="24" />
                    </Label>
                    <Group translation="[300, 32]">
                        <Label id="actorPanelName" text="" color="#FFFFFF" width="720" maxLines="1">
                            <Font role="font" uri="pkg:/fonts/InterDisplay-Bold.ttf" size="42" />
                        </Label>
                        <Rectangle width="720" height="1" color="#2A2A2A" translation="[0, 64]" />
                        <Label id="actorPanelBio" text="" color="#D2D2D2" width="720" maxLines="10" wrap="true" lineSpacing="4" translation="[0, 82]">
                            <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="24" />
                        </Label>
                    </Group>
                </Group>
            </Group>
        </Group>
    </children>
</component>
